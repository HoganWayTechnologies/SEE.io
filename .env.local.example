# Example environment variables for local development
# Copy to `.env.local` and fill with your secrets

NEXT_PUBLIC_SEE_API_URL=https://socxalapi-prod-e3btc0b3h8bccsgv.eastus2-01.azurewebsites.net/SEEAPI
NEXT_PUBLIC_SOCXAL_API_URL=https://socxalapi-prod-e3btc0b3h8bccsgv.eastus2-01.azurewebsites.net/SocxalAPI/

# Firebase (for Socxal -> Firebase custom token sign-in)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin service account JSON (stringified). Required for server session cookie creation.
# In production, store this securely (Vercel Secrets / environment variables). Example:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
FIREBASE_SERVICE_ACCOUNT=

# Stripe (for later)
NEXT_PUBLIC_STRIPE_PK=
